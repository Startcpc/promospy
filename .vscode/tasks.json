{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PromoSpy: запустить",
      "type": "process",
      "command": "python3",
      "args": ["start.py"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "START_WINDOWS.cmd"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "detail": "Подготовить зависимости, собрать сайт и открыть его в браузере. Остановка: Ctrl+C."
    },
    {
      "label": "PromoSpy: редактировать сайт",
      "type": "process",
      "command": "python3",
      "args": ["start.py", "--dev"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "START_WINDOWS.cmd", "--dev"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "detail": "Режим разработки: изменения в коде появляются в браузере. Остановка: Ctrl+C."
    }
  ]
}
