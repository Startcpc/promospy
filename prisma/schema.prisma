// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoOffer {
  id                  String   @id @default(cuid())
  companyId           Int
  code                String
  codeKey             String
  description         String
  searchText          String   @default("")
  discount            String
  status              String   @default("found")
  conditions          String   @default("[]")
  sources             String   @default("[]")
  minOrder            Float?
  startsAt            DateTime?
  expiresAt           DateTime?
  foundAt             DateTime @default(now())
  lastSeenAt          DateTime @default(now())
  checkedAt           DateTime?
  validUntil          DateTime?
  invalidSince        DateTime?
  verificationDetails String?
  evidence            String?
  checks              PromoCheck[]

  @@unique([companyId, codeKey])
  @@index([companyId, status])
  @@index([expiresAt])
}

model PromoCheck {
  id        String     @id @default(cuid())
  offerId   String
  offer     PromoOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  status    String
  checkedAt DateTime   @default(now())
  details   String
  evidence  String?

  @@index([offerId, checkedAt])
}

// One durable queue entry per company; repeated requests share it.
model PromoScanJob {
  companyId  Int       @id
  state      String    @default("queued")
  requestedAt DateTime @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  nextRunAt  DateTime  @default(now())
  owner      String?
  leaseUntil DateTime?
  error      String?
  officialCheckedAt DateTime?
  officialError String?
  log        String    @default("[]")

  @@index([state, requestedAt])
}

// A renewable lease limits browser work across all server processes sharing this database.
model PromoWorkerLease {
  id        String   @id
  owner     String
  expiresAt DateTime
}
