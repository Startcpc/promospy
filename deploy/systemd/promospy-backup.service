[Unit]
Description=Validated online SQLite backup for PromoSpy

[Service]
Type=oneshot
User=promospy
Group=promospy
WorkingDirectory=/opt/promospy
EnvironmentFile=/etc/promospy.env
ExecStart=/usr/bin/node scripts/backup-db.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/promospy
