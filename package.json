{
  "name": "promospy",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack && node scripts/copy-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./scripts/register-ts.mjs --test --experimental-test-isolation=none tests/saved-promos.test.ts tests/request-origin.test.ts tests/web-search.test.ts tests/search-store.test.ts tests/source-extraction.test.ts tests/browser-request.test.ts tests/search-cache.test.ts tests/engine-regressions.test.ts tests/public-http.test.ts tests/discovery-engine.test.ts tests/source-ai.test.ts tests/search-lifecycle.test.ts tests/acceptance-regressions.test.ts tests/source-http-failures.test.ts tests/public-catalogues.test.ts",
    "test:search": "node --import ./scripts/register-ts.mjs scripts/test-search.ts",
    "test:smoke": "node --import ./scripts/register-ts.mjs --test --experimental-test-isolation=none tests/web-ui.test.ts tests/browser-reader.test.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/restore-db.mjs",
    "test:ui": "node --import ./scripts/register-ts.mjs --test --experimental-test-isolation=none tests/web-ui.test.ts tests/browser-reader.test.ts",
    "test:live": "node --import ./scripts/register-ts.mjs scripts/test-live.ts",
    "test:launcher": "node scripts/test-launcher.mjs",
    "test:database": "node --test tests/database-tools.test.mjs",
    "cache:backup": "node --import ./scripts/register-ts.mjs scripts/search-cache.mjs backup",
    "cache:restore": "node --import ./scripts/register-ts.mjs scripts/search-cache.mjs restore",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:search && pnpm test:database && pnpm test:launcher && pnpm build && pnpm test:ui"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "playwright": "^1.64.1"
  },
  "packageManager": "pnpm@11.25.0"
}
