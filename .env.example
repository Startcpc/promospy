DATABASE_URL=file:../db/custom.db
# Long-lived Next.js server runs one shared background queue by default.
PROMO_WORKER_ENABLED=1
# Optional external discovery via a configured z-ai SDK. Known sources work without it.
PROMO_WEB_SEARCH_ENABLED=0

# Optional validated online SQLite backups (defaults: backups beside DB, 14 days).
# PROMO_BACKUP_DIR=/var/lib/promospy/backups
# PROMO_BACKUP_KEEP_DAYS=14

# Official publication is collected first; then up to 3 isolated cart checks per scan.
PROMO_CART_CHECKS_ENABLED=1
# Optional installed system Chromium executable.
# PROMO_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# For a reverse proxy with a rewritten Host header. Codespaces is detected automatically.
# PROMO_PUBLIC_ORIGIN=https://your-domain.example
