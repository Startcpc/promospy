# No API keys, AI, database engine or cart browser is required.
# Search starts only after clicking Refresh, then refreshes every 5 minutes while the server runs.
PROMO_SEARCH_DATA_DIR=.cache/promo-search
# Optional destination for cache:backup; seven recent copies are retained.
# PROMO_SEARCH_BACKUP_DIR=.cache/search-backups
# Optional for a reverse proxy rewriting the Host header. Local startup needs no .env.
# PROMO_PUBLIC_ORIGIN=https://your-site.example
# Docker Compose host port; the container always listens on port 3000.
# PROMO_PORT=3000
# Optional trusted CA file for compose.ca.yaml; not copied into the image.
# PROMO_CA_FILE=/absolute/path/to/company-ca.pem

# Optional crawl limits. Defaults work without editing this file.
# PROMO_SEARCH_MAX_PAGES=30
# PROMO_SEARCH_DISCOVERY_REQUESTS=12
# PROMO_SEARCH_TIMEOUT_MS=90000
# PROMO_HTTP_CONCURRENCY=6
# PROMO_HTTP_PER_HOST=2
# PROMO_HTTP_INTERVAL_MS=500

# Optional ordinary JavaScript rendering, only for explicitly permitted hosts.
# Requires an already installed Chromium. No browser is downloaded by start.py.
# PROMO_BROWSER_ENABLED=1
# PROMO_BROWSER_HOSTS=vkusvill.ru
# PROMO_BROWSER_EXECUTABLE=/path/to/chromium
# PROMO_BROWSER_RESOURCE_HOSTS=public-cdn.example

# Optional local Ollama with an already installed free model. No model download.
# PROMO_OLLAMA_URL=http://127.0.0.1:11434/
# PROMO_OLLAMA_MODEL=your-local-model
