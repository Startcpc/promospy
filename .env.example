DATABASE_URL=file:../db/custom.db
# Long-lived Next.js server runs one shared background queue by default.
PROMO_WORKER_ENABLED=1
# Optional external discovery via a configured z-ai SDK. Known sources work without it.
PROMO_WEB_SEARCH_ENABLED=0

# Optional validated online SQLite backups (defaults: backups beside DB, 14 days).
# PROMO_BACKUP_DIR=/var/lib/promospy/backups
# PROMO_BACKUP_KEEP_DAYS=14
